# Copiez ce fichier en .env et remplissez vos clés
TRADING_MODE=alpaca-paper  # paper (local) | alpaca-paper (compte paper Alpaca) | live (argent réel)

# Clés Alpaca (requises pour le mode live)
# Obtenez-les sur https://alpaca.markets
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
